# Template file for 'pcsclite'
pkgname=pcsclite
version=2.5.3
revision=1
build_style=meson
configure_args="-Dlibudev=true $(vopt_bool systemd libsystemd) -Dsystemdunit=system -Dpolkit=false"
hostmakedepends="pkg-config python3 flex perl"
makedepends="eudev-libudev-devel libusb-devel python3-devel $(vopt_if systemd libsystemd-devel)"
depends="python3"
short_desc="Middleware to access a smart card using SCard API (PC/SC)"
maintainer="Andrew Benson <abenson+void@gmail.com>"
license="BSD-2-Clause, GPL-3.0-or-later"
homepage="https://salsa.debian.org/debian/pcsc-lite"
distfiles="https://salsa.debian.org/debian/pcsc-lite/-/archive/upstream/${version}/pcsc-lite-upstream-${version}.tar.gz"
checksum=e8809f610357fef05c18fe2b7d43379d61ebb72db3d0c0d4b10299ccab30d593

build_options="systemd"

post_patch() {
	vsed -e 's/u! pcscd/u! _pcscd/' -i etc/pcscd-sysusers.conf
	vsed -e 's/User=pcscd/User=_pcscd/' -i etc/pcscd.service.in
	vsed -e 's/SocketUser=pcscd/SocketUser=_pcscd/' -i etc/pcscd.socket.in
	vsed -e 's/SocketGroup=pcscd/SockeGroup=_pcscd/' -i etc/pcscd.socket.in
}

post_install() {
	vsv pcscd
	vlicense COPYING
	vdoc "${FILESDIR}/README.voidlinux"
}

pcsclite-devel_package() {
	short_desc+=" - development files"
	depends="libpcsclite>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}

libpcsclite_package() {
	short_desc+=" - library files"
	pkg_install() {
		vmove "usr/lib/*.so.*"
	}
}
